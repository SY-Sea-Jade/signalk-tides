  },
  "keywords": [
    "signalk-webapp",
    "signalk-node-server-plugin",
    "signalk-category-cloud"
  ],
  "author": {
    "name": "Brandon Keepers",
    "url": "https://github.com/bkeepers"
  },
  "contributors": [
    {
      "name": "Joachim Bakke"
    },
    {
      "name": "Scott Bender"
    }
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@neaps/api": "^0.5.0",
    "@signalk/server-api": ">=2.0",
    "express": "^5.2",
    "geolib": "^3.3.4",
    "moment": "^2.30.1",
    "@neaps/tide-predictor": "^0.9.0",
    "neaps": "0.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-hook/resize-observer": "^2.0.2",
    "@tailwindcss/vite": "^4.1.3",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.1",
    "d3": "^7.9.0",
    "browserslist":"<4.28.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "signalk-server": ">2.13.5",
    "tailwindcss": "^4.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^8.0.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SY-Sea-Jade/signalk-tides.git"
