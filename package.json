{
  "name": "@syseajade/signalk-tides-forked",
  "version": "1.5.0",
  "description": "Tidal predictions for the vessel's position from various online sources. Forked with latest neaps tidal library.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "prepare": "npm run build",
